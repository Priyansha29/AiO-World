# Frontend environment variables (copy to .env.local and fill in).
# Only VITE_* values are exposed to the browser — never put a service-role
# key or secret here.

# AiO Library + Subjects notes — Supabase storage (optional; hosted files need these).
# Library: create the public `library` bucket (books/…).
# Subjects notes: files upload to the public `Files` bucket (Subjects/<Subject Name>/*.pdf).
# Only the project URL is required today — public note PDFs download without a key.
VITE_SUPABASE_URL=
# Reserved for the library's storage API listing later; not needed for subject notes.
VITE_SUPABASE_ANON_KEY=