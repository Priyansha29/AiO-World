# Frontend environment variables (copy to .env.local and fill in).
# Only VITE_* values are exposed to the browser — never put a service-role
# key or secret here.

# Nanny Mania streams a desktop session over noVNC.
VITE_NANNY_MANIA_URL=http://localhost:6080/vnc.html?autoconnect=true&resize=scale

# AiO Library — Supabase storage (optional; hosted PDFs need these).
# Create the public `library` bucket, then set the project URL + anon key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=